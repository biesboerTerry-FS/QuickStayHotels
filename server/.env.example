# MongoDB Atlas connection string (required)
# Example: mongodb+srv://user:password@cluster.mongodb.net/quickstay?retryWrites=true&w=majority
MONGODB_URI=

# Clerk credentials (required)
# Get them from https://dashboard.clerk.com/ -> API Keys
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk webhook signing secret (required for user sync)
# Create a webhook endpoint in Clerk dashboard pointing to /api/clerk
CLERK_WEBHOOK_SECRET=whsec_...

# JWT signing secret for authenticated state-changing routes (required)
# Generate with: openssl rand -hex 32  (must be at least 32 characters)
JWT_SECRET=
# Access token lifetime (optional, defaults to 12h)
JWT_EXPIRES_IN=12h

# Allowed frontend origin for CORS (required in production)
# Use your deployed Vercel web URL
CORS_ORIGIN=http://localhost:5173

# Cloudinary credentials (optional, required only for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend email API key (optional, required only for booking confirmations)
RESEND_API_KEY=
FROM_EMAIL=QuickStay <onboarding@resend.dev>

# Sentry DSN (optional, for error tracking)
SENTRY_DSN=

# Node environment (set automatically by Vercel)
NODE_ENV=development
