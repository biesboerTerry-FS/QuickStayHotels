# Clerk public key (required outside of demo mode)
# Get it from https://dashboard.clerk.com/ -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Backend API URL (required for production)
# Use the URL of your deployed Vercel API project
VITE_API_BASE_URL=http://localhost:3000

# Sentry DSN (optional, for error tracking)
# VITE_SENTRY_DSN=https://...@....ingest.sentry.io/...

# Demo mode: show a "Try demo" button so visitors can explore gated sections without signing up.
# Set to true in .env.local for local development demos.
# VITE_DEMO_MODE=true

# Dev only: bypass owner auth for local testing (set to true in .env.local)
# VITE_DEV_OWNER_BYPASS=true
